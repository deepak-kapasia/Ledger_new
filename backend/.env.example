# Copy this file to .env and replace each placeholder with a local value.

MONGO_URI=mongodb://127.0.0.1:27017/ledger
JWT_SECRET=replace-with-a-long-random-string
EMAIL_USER=your-email@example.com

# Gmail OAuth2 is used through Gmail's HTTPS API and works on Render Free.
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret
REFRESH_TOKEN=your-oauth-refresh-token

# Optional local/paid-Render SMTP fallback. Render Free blocks SMTP ports.
# EMAIL_PASSWORD=your-gmail-app-password

# Optional settings
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
