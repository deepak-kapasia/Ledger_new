# Copy this file to .env and replace each placeholder with a local value.

MONGO_URI=mongodb://127.0.0.1:27017/ledger
JWT_SECRET=replace-with-a-long-random-string
EMAIL_USER=your-email@example.com

# Recommended for a single Gmail sender (requires Google 2-Step Verification).
# If set, EMAIL_PASSWORD is used instead of the OAuth2 variables below.
EMAIL_PASSWORD=your-gmail-app-password

# OAuth2 alternative: leave EMAIL_PASSWORD empty when using these.
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret
REFRESH_TOKEN=your-oauth-refresh-token

# Optional settings
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
